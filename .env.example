# Platform Configuration
APP_NAME="AI Interview Platform"
ENVIRONMENT="production"
API_V1_PREFIX="/api/v1"

# Database Connection (MongoDB Atlas)
MONGODB_URI="replace-with-your-mongodb-atlas-uri"
MONGODB_DB="interview_platform"

# AI Evaluation & Adaptive Engine
OPENAI_API_KEY="your-openai-api-key"

# Recruiter & Admin Portal Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Recruiter Admin"

# AI Proctoring Engine Configuration
PROCTOR_MAX_WARNINGS=5
PROCTOR_WARN_COOLDOWN=20.0
PROCTOR_PERSON_CONF=0.5
PROCTOR_DEVICE_CONF=0.08
PROCTOR_IMAGE_SIZE=640

# Frontend API Target (Only if hosting Frontend separately as a Static Site)
# VITE_API_URL="https://ai-interview-backend.onrender.com/api/v1"
